# ============================================================
# LexiSense AI & Email Backend Configuration
# ============================================================

# Server Port
PORT=3000

# OpenAI API Key (Optional, for Live Ollie AI Chatbot)
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini

# ============================================================
# Custom Sender & SMTP Mail Settings (e.g. noreply@mykasih.com.my)
# ============================================================
# Sender Display Name & Email Address
MAIL_FROM_NAME="LexiSense Screening"
MAIL_FROM="noreply@mykasih.com.my"

# ------------------------------------------------------------
# OPTION 1: Resend / SMTP Relay (Recommended for Custom Domains)
# ------------------------------------------------------------
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_resend_api_key

# ------------------------------------------------------------
# OPTION 2: Domain cPanel / Webmail SMTP (mykasih.com.my)
# ------------------------------------------------------------
# SMTP_HOST=mail.mykasih.com.my
# SMTP_PORT=465
# SMTP_USER=noreply@mykasih.com.my
# SMTP_PASS=your_cpanel_email_password

# ------------------------------------------------------------
# OPTION 3: Google Workspace / Gmail App Password
# ------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@mykasih.com.my
# SMTP_PASS=xxxx xxxx xxxx xxxx  (Google 16-character App Password)
